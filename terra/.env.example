# Discord
DISCORD_TOKEN=bot-token-buraya
CLIENT_ID=uygulama-client-id

# Firebase: service-account JSON'unun TAMAMINI tek satır string olarak yapıştır.
# Örn: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
FIREBASE_PROJECT_ID=proje-id
